# ---- AVEVA PI Web API ----
# Base URL of the PI Web API (include the /piwebapi suffix).
# For the local mock server use: http://localhost:8080/piwebapi
PI_BASE_URL=http://localhost:8080/piwebapi

# PI authentication. The mock server ignores these.
# For a real PI Web API this is typically Kerberos or Basic auth.
PI_AUTH_MODE=none          # none | basic
PI_USERNAME=
PI_PASSWORD=

# Verify TLS certs when talking to a real PI Web API (set to false for self-signed lab certs).
PI_VERIFY_SSL=true

# Comma-separated PI point paths to ingest.
# Real format: \\PIServerName\TagName
PI_POINTS=\\PISRV01\PlantA_Generator01_Temperature,\\PISRV01\PlantA_Generator02_Temperature,\\PISRV01\PlantB_Generator03_Temperature,\\PISRV01\PlantA_Generator01_Power,\\PISRV01\PlantA_Generator02_Power,\\PISRV01\PlantB_Generator03_Power

# How often to poll, in seconds.
POLL_INTERVAL_SECONDS=5

# Backfill: read recorded values since the last checkpoint. On first run
# (no checkpoint) seed this many minutes of history.
BACKFILL_START_MINUTES=60
RECORDED_MAX_COUNT=5000

# Health/metrics HTTP server (GET /healthz, GET /metrics).
HEALTH_PORT=9100

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# Key prefix + retention for the RedisTimeSeries keys (milliseconds; 0 = keep forever).
REDIS_KEY_PREFIX=pi
REDIS_TS_RETENTION_MS=604800000   # 7 days

# Downsampling: auto-create a TS.CREATERULE rollup series per tag
# (raw samples -> aggregated buckets). Rollup key: pi:ts:<tag>:avg_1m
DOWNSAMPLE_ENABLED=true
DOWNSAMPLE_BUCKET_MS=60000        # 1-minute buckets
DOWNSAMPLE_AGGREGATION=avg        # avg | min | max | sum | count | first | last
